# apps/api — the control plane.
#
# LEAVE UNUSED VARIABLES COMMENTED OUT, never blank. `FOO=` sets FOO to the
# empty string and the schema rejects that: an optional variable is optional
# when it is ABSENT, not when it is empty. (`PORT=` coerces to 0 and fails the
# same way.) A single blank line here stops the api from booting.
#
# Variables this service must NEVER be given — it exits at startup if handed
# one: CLICKHOUSE_URL, any CLICKHOUSE_*_PASSWORD, EVENT_STREAM_REDIS_URL,
# RESEND_API_KEY, TELEGRAM_BOT_TOKEN, ANONYMOUS_IDENTITY_SECRET. The api reaches
# analytics only through the signed query gateway, and it never delivers mail.

NODE_ENV=production
# Must MATCH the gateway's ENVIRONMENT. The signed-query audience defaults to
# `query-gateway:<ENVIRONMENT>` on both sides, so a mismatch here rejects every
# analytics read with a signature error that names neither variable.
ENVIRONMENT=production
LOG_LEVEL=info
PORT=8082

DATABASE_URL=postgres://openanalytics:{{POSTGRES_PASSWORD}}@postgres:5432/openanalytics
# Postgres on Neon (recommended managed option — ../NEON.md): the DIRECT
# connection string, pooling off, so no `-pooler` in the host. The same string
# goes in api.env, collector.env, worker.env and migrate.env.
#DATABASE_URL=postgresql://neondb_owner:<password>@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# The shared nonce store, and the near-realtime usage counter.
# ADDRESSED BY IP, NOT BY SERVICE NAME — see note 2 in docker-compose.yml.
REALTIME_CACHE_REDIS_URL=redis://:{{VALKEY_REALTIME_PASSWORD}}@{{VALKEY_REALTIME_IP}}:6379

# --- public identity --------------------------------------------------------
# Three different URLs with three different jobs:
#   AUTH_BASE_URL       Better Auth's own base — this api's public origin. The
#                       OAuth callback registered with Google/GitHub is
#                       {AUTH_BASE_URL}/api/auth/callback/{google,github}.
#   APP_BASE_URL        the DASHBOARD's origin. Every link meant for a human
#                       (invitation acceptance, billing returns) is built from
#                       it. Unset, those links fall back to AUTH_BASE_URL and
#                       point at pages the api does not serve.
#   COLLECTOR_BASE_URL  the ingest origin. The install block the api hands to
#                       unattended integrations is derived from it.
AUTH_BASE_URL={{AUTH_BASE_URL}}
APP_BASE_URL={{APP_BASE_URL}}
COLLECTOR_BASE_URL={{COLLECTOR_BASE_URL}}

# One variable, two boundaries: Better Auth's origin/CSRF check and the
# credentialed CORS allowlist. Comma-separated. UNSET, THE API EMITS NO
# Access-Control-Allow-Origin AND EVERY BROWSER CALL FROM THE DASHBOARD IS
# REFUSED — fail-closed, by design.
AUTH_TRUSTED_ORIGINS={{APP_BASE_URL}}

# Shown in the product and in the mail it sends.
PRODUCT_NAME=Open Analytics

# --- secrets ----------------------------------------------------------------
AUTH_SECRET={{AUTH_SECRET}}
# Keys the one-time-trial claim, which is keyed on an email HMAC and never the
# address itself.
TRIAL_IDENTITY_SECRET={{TRIAL_IDENTITY_SECRET}}
# Keys the source fingerprint on the credential event journal — a hash of the
# addresses API keys and CLIs connect from. Unset, no credential event is
# journalled at all; reads are untouched.
CREDENTIAL_SOURCE_SECRET={{CREDENTIAL_SOURCE_SECRET}}
# Encrypts customers' own payment-provider keys at rest. MUST BE BYTE-IDENTICAL
# to the worker's copy — the api encrypts, the worker decrypts, and two
# different rings cannot read each other's rows.
OA_CREDENTIAL_KEYRING={{OA_CREDENTIAL_KEYRING}}

# The two Ed25519 PRIVATE halves (query signing, realtime tokens) are NOT
# here. A multi-line PEM cannot live in an env file — Docker
# passes an escaped "\n" through as two literal characters and the key parser
# rejects it. They are YAML block scalars in `docker-compose.override.yml`,
# written by ./generate-secrets.sh.

# --- signed reads -----------------------------------------------------------
QUERY_GATEWAY_URL=http://gateway:8081
# The gateway accepts exactly one key id. Bump it on both sides when you rotate
# the pair: a stale signer then fails as "Unknown signing key" rather than as a
# signature error, which is the more diagnosable of the two.
QUERY_SIGNING_KEY_ID=oa-selfhost-1
# Leave unset unless you set it on the gateway too — both default to
# `query-gateway:<ENVIRONMENT>`.
# QUERY_GATEWAY_AUDIENCE=

# --- sign-in ----------------------------------------------------------------
# A provider is offered only when BOTH its id and secret are present, so a
# deployment with neither pair simply has no Google/GitHub button. Register the
# callback as {AUTH_BASE_URL}/api/auth/callback/google (and /github).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email+password sign-in. ON by default here, and off on the hosted deployment.
#
# This is the only door a self-hosted install has that needs neither a third-party
# OAuth app nor a working mail server, so it is what the first-run screen uses:
# a fresh install shows "create the first account" at /login, and the account it
# makes signs in with this. Turning it off leaves that account unusable until
# OAuth or SMTP works.
#
# It is not a bootstrap flag to switch back afterwards. Password sign-in is a
# normal way in for an install that runs on its owner's hardware.
AUTH_PASSWORD_SIGNIN=enabled

# Whether a password session requires a verified address first. Leave it alone.
# The first account is written verified — there is no mail to verify it with,
# which is the whole reason it exists — so the usual install never needs this.
# It is the escape hatch for an install whose mail transport broke later and
# which needs a password account it never verified.
# AUTH_EMAIL_VERIFICATION=optional

# --- optional integrations --------------------------------------------------
# Subscription billing. Unset, the billing surfaces disable themselves cleanly
# and everything else runs — which is what a self-hosted install normally wants.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# The AI assistant. Unset, its routes stay mounted and answer 503 "not
# configured" BEFORE any question is charged, and the dashboard's chat button
# is drawn disabled rather than offering an error.
#
# You do not have to set it here either: Account → Deployment stores a key
# encrypted, it wins over this variable, and it takes effect on the next
# question with no restart.
# OPENAI_API_KEY=
# ASSISTANT_MODEL=
# OPENAI_BASE_URL=

# Whether that screen exists. `enabled` is the default and is what a
# single-tenant install wants. Set `disabled` on a multi-tenant deployment,
# where the environment IS the configuration. The worker reads the same
# variable and the two must agree.
#
# Only the account that claimed this deployment — the oldest one — may use the
# screen, and it needs OA_CREDENTIAL_KEYRING above to encrypt what it stores.
# DEPLOYMENT_SETTINGS=enabled

# Object storage for data import and export (see the object-storage profile).
# All five or none: a signature needs the endpoint, region, bucket and key pair,
# so a partial block is treated as "not configured" and the import surface is
# simply not mounted.
# OBJECT_STORAGE_ENDPOINT=http://rustfs:9000
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=openanalytics
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Metrics, in Prometheus remote-write format. Without them every service keeps
# its structured-log metrics floor.
# METRICS_REMOTE_WRITE_URL=
# METRICS_REMOTE_WRITE_USER=
# METRICS_REMOTE_WRITE_TOKEN=
