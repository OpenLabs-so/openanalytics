# MinIO — optional S3-compatible object storage, for data import and export.
# Enabled only with `docker compose --profile object-storage up -d`.
#
# Any S3-compatible provider works; this is here so a self-hosted install does
# not need one. After the first start, create the bucket and a pair of
# credentials, then fill in the five OBJECT_STORAGE_* variables in api.env and
# worker.env (all five or none — a partial block is treated as "not
# configured").
MINIO_ROOT_USER=openanalytics
MINIO_ROOT_PASSWORD={{MINIO_ROOT_PASSWORD}}
